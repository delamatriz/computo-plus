generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Empresa {
  id        String     @id @default(cuid())
  nombre    String
  rut       String     @unique
  logo      String?
  matricula String?
  direccion String?
  telefono  String?
  email     String?
  web       String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  proyectos Proyecto[]
}

model Proyecto {
  id          String     @id @default(cuid())
  nombre      String
  subtitulo   String?
  cliente     String?
  moneda      String     @default("UYU")
  tipo        String     @default("VIVIENDA")
  tipoContratacion String @default("PRIVADA") // "PRIVADA" | "PUBLICA"
  estado      String     @default("BORRADOR")
  descripcion String?
  trabajos    String?
  fechaInicio DateTime?
  plazoObra   Int?
  area        Float?
  direccion   String?
  empresaId   String?
  empresa     Empresa?   @relation(fields: [empresaId], references: [id])
  capitulos   Capitulo[]
  leyesSociales LeyesSociales?
  certificaciones Certificacion[]
  documentosLlamado DocumentoLlamado[]
  documentosMetraje DocumentoMetraje[]
  notas              String?    @db.Text // única por proyecto (ver UI_UX_REDESIGN.md 2quinquies) — antes vivía por-plano en PlanoProyecto.notas
  memoriaDescriptiva String? @db.Text
  fechaBaseIndice    DateTime?
  indiceBaseValor    Float?
  ultimaActualizacionIndice DateTime?
  generandoRubros    Boolean    @default(false)
  requierePlanSeguridad Boolean @default(false)
  modalidadAltura    String?    // "andamios" | "balancin" | "silleta" | "combinacion" | "grua" — pueden combinarse separados por coma
  incluyeIVA            Boolean   @default(false)
  timbresCJP            Float     @default(0)
  gastosGeneralesItems  Json?     // [{ id: string, descripcion: string, monto: number }]
  diasLaborales         Int?
  garantiaFielCumplimiento String? @db.Text
  garantiaViciosOcultos    String? @db.Text
  garantiaResponsabilidad  String? @db.Text
  // Cuándo se apretó "Entregar" (congela precios) por última vez — null si
  // el proyecto nunca fue entregado. Se muestra junto al badge de estado
  // cuando estado === "FINALIZADO".
  fechaUltimaEntrega DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model LeyesSociales {
  id         String   @id @default(cuid())
  proyectoId String   @unique
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  // Configuración del tipo de obra
  tipoContratante String @default("empresa") // "empresa" | "propietario_directo"

  // Monto imponible base (calculado desde APUs, editable)
  montoImponibleMO Float @default(0)

  // Porcentajes — con valores default Uruguay 2025
  // AUC (propietario)
  aucPct Float @default(0.714) // 71.4% — Código 2

  // Empresa — aportes patronales
  focerPatronalPct Float @default(0.075) // 7.5% — Código 145
  fscFocapPct      Float @default(0.010) // 1.0% — Código 34
  fosvocPct        Float @default(0.005) // 0.5% — Código 43
  frlPct           Float @default(0.002) // 0.2% — Código 47
  fondoGarantiaPct Float @default(0.005) // 0.5% — Código 49
  snisAdicionalPct Float @default(0.005) // 0.5% — Código 108

  // Empresa — aporte personal (descuento al obrero, la empresa lo retiene)
  focerPersonalPct Float @default(0.030) // 3.0% — Código 146

  updatedAt DateTime @updatedAt
}

model Capitulo {
  id          String    @id @default(cuid())
  nombre      String
  codigo      String
  color       String    @default("#2563EB")
  orden       Int       @default(0)
  fechaInicio DateTime?
  fechaFin    DateTime?
  proyectoId  String
  proyecto    Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  rubros      Rubro[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Fase 2, Etapa 4 — FK opcional al catálogo canónico. Nullable a
  // propósito: un capítulo de proyecto sin match limpio (nombre inventado
  // por el usuario) simplemente no tiene catálogo — mismo comportamiento
  // que hoy tiene obtenerMapeoSAU cuando no encuentra alias, no es una
  // regresión. Ver FASE2-DISENO-UNIFICACION-TAXONOMIAS.md.
  capituloCatalogoId String?
  capituloCatalogo   CapituloCatalogo? @relation(fields: [capituloCatalogoId], references: [id])
}

model Rubro {
  id          String   @id @default(cuid())
  codigo      String
  descripcion String
  unidad      String
  cantidad    Float    @default(0)
  // Origen del valor actual de `cantidad` — "MANUAL" (cargado a mano,
  // default) o "COMPUTO" (última vez que se escribió fue desde "Aplicar
  // al presupuesto" en la Planilla de cómputo). Sin esto no hay forma de
  // saber si aplicar el cómputo va a pisar un valor que el usuario cargó
  // a mano — ver aviso de confirmación en POST .../aplicar-computo.
  // PATCH /api/rubros/[id] vuelve a poner "MANUAL" apenas se edita
  // cantidad a mano, así el origen siempre refleja la última escritura.
  cantidadOrigen String @default("MANUAL")
  precioUnit  Float    @default(0)
  // Snapshot de precioUnit al momento del último "Entregar" — null significa
  // que el rubro se agregó DESPUÉS de esa entrega (rubro nuevo, sin precio
  // pactado que cuidar). No-null dispara el modal "actualizar vigente vs.
  // mantener pactado" al reabrir el presupuesto para editar (ver
  // lib/recalcularPrecioRubro.ts y actualizarRubro en proyectos/[id]/page.tsx).
  precioCongelado Float?
  tipo        String   @default("GLOBAL")
  trabajoEnAltura Boolean @default(false)
  capituloId  String
  capitulo    Capitulo @relation(fields: [capituloId], references: [id], onDelete: Cascade)
  apu         APU?
  certificacionItems CertificacionItem[]
  cotizaciones CotizacionProveedor[]
  mediciones  MedicionDocumento[]
  filasMetraje FilaMetraje[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CotizacionProveedor {
  id            String   @id @default(cuid())
  rubroId       String
  rubro         Rubro    @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  proveedor     String
  montoNeto     Float
  ivaPorcentaje Float    @default(22)
  leyesSociales Float    @default(0)
  financiacion  String   @default("")
  observaciones String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model APU {
  id                 String        @id @default(cuid())
  gastosGeneralesPct Float         @default(15)
  utilidadPct        Float         @default(10)
  // % de piedra bruta sobre 1 m3, para hormigón ciclópeo — desplaza volumen
  // de hormigón simple (cemento+arena+balasto) al recalcular en vivo.
  porcentajePiedra   Float         @default(0.30)
  rubroId            String        @unique
  rubro              Rubro         @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  materiales         MaterialAPU[]
  manoObra           ManoObraAPU[]
  equipos            EquipoAPU[]
  creadoEn           DateTime      @default(now())
  actualizadoEn      DateTime      @updatedAt
}

model MaterialAPU {
  id           String          @id @default(cuid())
  descripcion  String
  unidad       String
  rendimiento  Float
  precioUnit   Float           @default(0)
  dosificacion String?
  orden        Int             @default(0)
  apuId        String
  apu          APU             @relation(fields: [apuId], references: [id], onDelete: Cascade)
  componentes  ComponenteAPU[]
}

model ComponenteAPU {
  id                   String      @id @default(cuid())
  descripcion          String
  unidad               String
  rendimientoPorUnidad Float
  precioUnit           Float       @default(0)
  orden                Int         @default(0)
  materialId           String
  material             MaterialAPU @relation(fields: [materialId], references: [id], onDelete: Cascade)
}

model ManoObraAPU {
  id          String @id @default(cuid())
  categoria   String
  jornadaHs   Float  @default(8)
  rendimiento Float
  jornalRef   Float
  orden       Int    @default(0)
  apuId       String
  apu         APU    @relation(fields: [apuId], references: [id], onDelete: Cascade)

  // Vincula esta línea a una línea de Equipo cuando representa su mano de obra
  // de armado/desarme — permite incluirla o excluirla del Costo Directo según
  // el modo de costeo del equipo (ver EquipoAPU.modoCosteo).
  equipoRelacionadoId String?
  equipoRelacionado   EquipoAPU? @relation("ArmadoDeEquipo", fields: [equipoRelacionadoId], references: [id], onDelete: SetNull)
}

model EquipoAPU {
  id          String @id @default(cuid())
  descripcion String
  unidad      String
  rendimiento Float
  costoUnit   Float // precio de alquiler de mercado — no se pisa al pasar a modo Propio
  orden       Int    @default(0)
  apuId       String
  apu         APU    @relation(fields: [apuId], references: [id], onDelete: Cascade)

  // "ALQUILADO" (default) | "PROPIO_CON_COSTO" | "PROPIO_SIN_COSTO"
  modoCosteo      String       @default("ALQUILADO")
  costoUnitPropio Float? // costo propio cargado a mano, solo usado en PROPIO_CON_COSTO
  manoObraRelacionada ManoObraAPU[] @relation("ArmadoDeEquipo")
}

model Receta {
  id          String             @id @default(cuid())
  nombre      String
  descripcion String?
  unidad      String
  componentes RecetaComponente[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecetaComponente {
  id       String @id @default(cuid())
  material String
  unidad   String
  cantidad Float
  precio   Float
  recetaId String
  receta   Receta @relation(fields: [recetaId], references: [id], onDelete: Cascade)
}

model CategoriaLaboral {
  id        String   @id @default(cuid())
  nombre    String
  categoria String
  jornal    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CapituloEstandar {
  id         String   @id @default(cuid())
  nombre     String
  orden      Int
  origen     String   @default("estandar") // "estandar" | "manual"
  vecesUsado Int      @default(1)
  createdAt  DateTime @default(now())

  @@unique([nombre])
}

// Anuncios del sistema mostrados en el panel de la campanita del Header
// (ej. "Se actualizó la lista de precios de materiales"). Carga manual
// vía Prisma Studio o script — sin formulario de alta en la UI, mismo
// criterio que los links de Materiales/Mano de Obra/Biblioteca. Sin
// estado de leído/no leído: la app es mono-tenant, no hace falta.
model EventoSistema {
  id          String   @id @default(cuid())
  titulo      String
  descripcion String
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())
}

// Fase 2 — catálogo canónico de capítulo/subcapítulo (unificación de las
// taxonomías paralelas: CapituloEstandar, SubrubroEstandar.capitulo/
// subcapitulo como strings sueltos, y CAPITULOS_SAU hardcodeado en
// page.tsx). Ver FASE2-DISENO-UNIFICACION-TAXONOMIAS.md.
//
// Etapa 1 (esta): tablas puramente aditivas, sembradas desde los valores
// reales de SubrubroEstandar. Nada en la app las consume todavía — eso
// llega en la Etapa 2 (SubrubroEstandar referencia por FK) y Etapa 4/5
// (Capitulo real referencia por FK, CAPITULOS_SAU se reduce).
model CapituloCatalogo {
  id                 String                 @id @default(cuid())
  nombre             String                 @unique
  orden              Int                    @default(0)
  activo             Boolean                @default(true)
  subcapitulos       SubcapituloCatalogo[]
  subrubros          SubrubroEstandar[]
  createdAt          DateTime               @default(now())

  // Fase 2, Etapa 4 — lado inverso de Capitulo.capituloCatalogoId (capítulos
  // reales de proyecto que se linkearon a esta entrada del catálogo).
  capitulosReales    Capitulo[]
}

model SubcapituloCatalogo {
  id                 String           @id @default(cuid())
  capituloCatalogoId String
  capituloCatalogo   CapituloCatalogo @relation(fields: [capituloCatalogoId], references: [id], onDelete: Cascade)
  nombre             String
  orden              Int              @default(0)
  subrubros          SubrubroEstandar[]
  createdAt          DateTime         @default(now())

  // Fase 2, Etapa 4 — lado inverso de ParticionSubcapitulo.subcapituloId.
  particion          ParticionSubcapitulo?

  @@unique([capituloCatalogoId, nombre])
}

// Fase 2, Etapa 5 — poblada con los 7 casos de partición conocidos
// (Pisos, Impermeabilizaciones, Muros, Revoques dentro de Albañilería;
// Herrería dentro de Carpinterías; Equipamiento y Obra Exterior/Jardín
// dentro de Acondicionamientos). capituloRealDestino es el nombre libre
// del Capitulo real de proyecto (String, no FK) porque un mismo
// CapituloCatalogo (ej. Albañilería) se reparte entre VARIOS capítulos
// reales distintos — no hay una única entidad "destino" a la que
// apuntar con FK, es el nombre canónico que usa el proyecto para esa
// fase. Ajustado en la Etapa 5 respecto al schema de la Etapa 4, que
// usaba capituloCatalogoDestinoId (FK a CapituloCatalogo) — no tenía
// sentido: el destino de una partición es un capítulo REAL, no una
// entrada más de catálogo.
model ParticionSubcapitulo {
  id                  String              @id @default(cuid())
  subcapituloId       String              @unique
  subcapitulo         SubcapituloCatalogo @relation(fields: [subcapituloId], references: [id])
  capituloRealDestino String
}

model Configuracion {
  id                  String    @id @default(cuid())
  jornalBase          Float     @default(0)
  aportesBPS          Float     @default(0.785)
  margenEmpresa       Float     @default(0.20)
  margenImprevistos   Float     @default(0.05)
  iva                 Float     @default(0.22)
  monedaDefault       String    @default("UYU")
  convenioFechaVigente DateTime?
  // URL de Vercel Blob (store privado) de la última foto del convenio SUNCA
  // subida en Configuración → Categorías Laborales SUNCA, confirmada por el
  // usuario (se guarda recién al hacer clic en "Guardar cambios", no apenas
  // se sube la imagen — ver guardarCambios en configuracion/page.tsx). Se
  // sirve en /mano-de-obra vía el proxy .../convenio-imagen (no directo,
  // mismo motivo que urlProxyDocumentoMetraje en lib/blob.ts).
  convenioImagenUrl   String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Certificacion {
  id          String   @id @default(cuid())
  proyectoId  String
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  numero      Int
  nombre      String   @default("")  // ej: "Certificado Nº1 — Octubre 2025"
  fecha       DateTime @default(now())
  observaciones String @default("")
  items       CertificacionItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CertificacionItem {
  id               String        @id @default(cuid())
  certificacionId  String
  certificacion    Certificacion @relation(fields: [certificacionId], references: [id], onDelete: Cascade)
  rubroId          String
  rubro            Rubro         @relation(fields: [rubroId], references: [id], onDelete: Cascade)
  porcentajeAvance Float         @default(0)   // 0-100
  cantidadEjecutada Float?                      // opcional
  fotos            FotoCertificacionItem[]
  @@unique([certificacionId, rubroId])
}

model FotoCertificacionItem {
  id                  String            @id @default(cuid())
  certificacionItemId String
  certificacionItem   CertificacionItem @relation(fields: [certificacionItemId], references: [id], onDelete: Cascade)
  url                 String            // base64 o ruta del archivo
  createdAt           DateTime          @default(now())
}

// Documentación del llamado — repositorio de entrada (Pliego, Memoria del
// pliego, fotos y planos de referencia) para CONSULTAR/ARCHIVAR, distinto de
// Metrajes (donde se sube un plano para MEDIR). Ver UI_UX_REDESIGN.md 2ter.
model DocumentoLlamado {
  id            String   @id @default(cuid())
  proyectoId    String
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  nombreArchivo String
  url           String   @db.Text // base64 (mismo patrón que FotoCertificacionItem)
  etiqueta      String   @default("OTRO") // "PLIEGO" | "MEMORIA" | "FOTOS" | "PLANOS" | "OTRO"
  tamano        Int?     // bytes, opcional
  createdAt     DateTime @default(now())
}

// Documentación para metrar — Página 1 (UI_UX_REDESIGN.md sección
// 2quinquies): 3 categorías independientes que comparten el mismo modelo
// (Planos y documentos / Fotos de relevamiento / Detalles), cada una con
// su propio listado + subida. Reemplaza a PlanoProyecto + FotoComplementaria
// (esta última era hija obligatoria de un plano puntual; "Fotos de
// relevamiento" pasó a ser una categoría propia e independiente, ya no
// atada a un plano específico — por eso el modelo se unificó en vez de
// mantenerse separado). El Visor necesita listar las 3 categorías juntas
// para su lista de documentos — con un solo modelo es una query, no un
// UNION de 3 formas distintas.
model DocumentoMetraje {
  id                    String   @id @default(cuid())
  proyectoId            String
  proyecto              Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  categoria             String   // "PLANO" | "FOTO" | "DETALLE"
  nombre                String   // ej. "Planta Baja", "Corte A-A"
  tipoArchivo           String   // "PDF" | "IMAGEN" | "DWG" (DWG: solo metadata/tipo, sin parseo — fuera de alcance, ver sección 6)
  archivo               String   @db.Text // URL de Vercel Blob
  nombreArchivoOriginal String
  paginaPDF             Int?     // página elegida (1-indexed), solo relevante para categoria=PLANO, PDF multipágina
  tamano                Int?     // bytes, opcional

  // Calibración de escala — Etapa 2 de "Metrajes con plano" (UI_UX_REDESIGN.md
  // sección 6). Solo tiene sentido para categoria=PLANO (se valida a nivel
  // de API/UI, no acá — no hay CHECK constraint por categoría en este
  // modelo unificado). Principio no negociable del diseño: sin calibración
  // no se puede medir. Método B (escala declarada, ej. "1:100") es el
  // implementado en esta ronda; metodoCalibracion ya deja lugar para
  // "COTA" (Método A — trazar una cota conocida), ronda futura.
  escalaDeclarada       String?  // texto tal cual lo tipeó el usuario, ej. "1:100"
  factorEscala          Float?   // factor numérico ya calculado (M/N de "N:M"), para los cálculos de medición futuros
  metodoCalibracion     String?  // "DECLARADA" | "COTA" (Método A, futuro)

  mediciones            MedicionDocumento[]
  anotaciones           Anotacion[]
  filasMetraje          FilaMetraje[]

  createdAt             DateTime @default(now())
}

// Marcas de medición trazadas sobre un plano — Etapa 3 de "Metrajes con
// plano" (UI_UX_REDESIGN.md sección 6, Modo A manual), primera ronda:
// solo tipo="LINEA". Persisten para trazabilidad visual (la línea queda
// dibujada sobre el plano al reabrirlo). Al crearse genera además una
// FilaMetraje puente (ver FilaMetraje.medicionId) para que aparezca en
// la Planilla de cómputo. xInicio/yInicio/xFin/yFin son porcentajes
// (0-100) del ancho/alto del documento, no píxeles — así el mapeo de
// coordenadas no depende del zoom/pan actual ni del ancho de render
// (900px en el visor principal, variable en la ventana flotante).
model MedicionDocumento {
  id            String           @id @default(cuid())
  documentoId   String
  documento     DocumentoMetraje @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  tipo          String           @default("LINEA") // "LINEA" | "AREA" | "PUNTO" (futuro)

  // LINEA — dos puntos fijos, en % del plano (0-100). Opcionales porque
  // AREA no los usa (validado en la API, no acá — mismo criterio que el
  // resto del modelo).
  xInicio       Float?
  yInicio       Float?
  xFin          Float?
  yFin          Float?
  longitudReal  Float?           // metros — solo tipo=LINEA (factorEscala × distancia en papel)

  // AREA — polígono de N vértices (N >= 3), mismo sistema de
  // coordenadas (% del plano, 0-100) que xInicio/etc. de LINEA.
  puntos        Json?            // [{ x: number, y: number }, ...] — solo tipo=AREA
  areaReal      Float?           // m² — solo tipo=AREA (shoelace × factorEscala², editable a mano antes de guardar)

  repeticiones  Float            @default(1)
  descripcion   String
  rubroId       String?
  rubro         Rubro?           @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())

  // Puente con la fila de Planilla que esta medición generó (ver
  // FilaMetraje.medicionId) — lado inverso, no se usa para escribir.
  filaMetraje       FilaMetraje?  @relation("FilaMedicionLargo")
  // Puente con la fila cuyo ANCHO se midió apuntando a ESTA medición en
  // vez de crear una fila nueva (ver FilaMetraje.medicionAnchoId) —
  // lado inverso, no se usa para escribir.
  filaMetrajeAncho  FilaMetraje?  @relation("FilaMedicionAncho")
}

// Fila de la Planilla de cómputo — reemplaza al estado local efímero
// que tenía este dato antes (ver metrajeFila.ts). Vive a nivel de
// documento porque nace de medir/describir algo sobre un plano puntual,
// pero el vínculo a Rubro y la suma de cantidades para "Aplicar al
// presupuesto" es a nivel de PROYECTO (varias filas de distintos
// documentos pueden sumar al mismo Rubro — ver POST
// .../proyectos/[id]/aplicar-computo). medicionId es el puente opcional
// con una MedicionDocumento (fila nacida de un trazo en el plano) — se
// borra en cascada si se borra la medición, mismo comportamiento que
// tenía antes eliminarMedicion() al sacar la fila del estado local.
// Filas manuales o generadas por IA no tienen medicionId.
//
// medicionAnchoId — segundo puente opcional, para medir el ANCHO de un
// elemento (ej. zapata) directo en el plano hacia una fila YA EXISTENTE
// en vez de crear una fila nueva (ver "ícono de regla" en
// PlanillaComputo.tsx). A propósito NO usa onDelete:Cascade como
// medicionId: borrar el trazo de ancho no tiene que borrar toda la fila
// (largo incluido) — solo dejar ancho en null. Con SetNull el FK se
// limpia solo a nivel de base, pero `ancho` y `unidad` no — esa parte
// se resuelve a nivel de aplicación (ver src/lib/recalculoUnidadFila.ts,
// usado tanto en el PATCH de filas-metraje como en el DELETE de
// mediciones) para que el número y la etiqueta nunca queden
// desincronizados del vínculo.
model FilaMetraje {
  id              String              @id @default(cuid())
  documentoId     String
  documento       DocumentoMetraje    @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  descripcion     String
  largo           Float?
  ancho           Float?
  alto            Float?
  cantidad        Float?
  // Unidad de la fila (m², m³, ml, etc.) — se autocompleta con la del
  // Rubro al vincular si estaba vacía; se valida contra Rubro.unidad en
  // el PATCH si ya tenía una propia (no se puede vincular si no coinciden).
  unidad          String?
  rubroId         String?
  rubro           Rubro?              @relation(fields: [rubroId], references: [id], onDelete: SetNull)
  medicionId      String?             @unique
  medicion        MedicionDocumento?  @relation("FilaMedicionLargo", fields: [medicionId], references: [id], onDelete: Cascade)
  medicionAnchoId String?             @unique
  medicionAncho   MedicionDocumento?  @relation("FilaMedicionAncho", fields: [medicionAnchoId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

// Anotaciones libres sobre un plano — reemplaza a MarcaReferencia (que
// solo servía para una letra fija en un punto). Dos herramientas, mismo
// modelo con discriminador `tipo`, mismo criterio que MedicionDocumento
// para LINEA/AREA: campos nullable según el tipo, sin CHECK constraint a
// nivel de base (se valida en la API). Ninguna de las dos mide nada (no
// requieren calibración), no se asocian a rubro, no generan fila en la
// Planilla — se eliminan con click + confirmación, igual que tenía Marca
// de referencia.
model Anotacion {
  id          String           @id @default(cuid())
  documentoId String
  documento   DocumentoMetraje @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  tipo        String           // "TRAZO" | "TEXTO"

  // TEXTO — punto de anclaje + contenido + tamaño de fuente en px (a
  // escala 100% de zoom — el contenedor que lo envuelve ya escala con
  // el zoom/pan del documento, así que no hace falta expresarlo en %).
  x           Float?           // % del plano (0-100)
  y           Float?           // % del plano (0-100)
  texto       String?
  tamano      Float?           // tamaño de fuente en px

  // TRAZO — path de N puntos a mano alzada (N >= 2), mismo sistema de
  // coordenadas (% del plano, 0-100) que el resto de las herramientas.
  puntos      Json?            // [{ x: number, y: number }, ...] — solo tipo=TRAZO
  color       String?          // hex, ej. "#2563EB" — solo tipo=TRAZO; null en filas viejas cae al azul default al renderizar

  createdAt   DateTime         @default(now())
}

model SubrubroEstandar {
  id              String       @id @default(cuid())
  codigo          String
  descripcion     String
  unidad          String
  precioUY        Float
  fechaBase       String       @default("2022-08")
  aportesSociales Float        @default(0)
  origen          String       @default("sau_ago2022")
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  apuEstandar     APUEstandar?

  // Fase 2, Etapa 6b — capitulo/subcapitulo (String) eliminados. El
  // catálogo canónico vía FK es ahora la única fuente de verdad. Ver
  // FASE2-DISENO-UNIFICACION-TAXONOMIAS.md.
  capituloId          String?
  capituloCatalogo    CapituloCatalogo?    @relation(fields: [capituloId], references: [id])
  subcapituloId       String?
  subcapituloCatalogo SubcapituloCatalogo? @relation(fields: [subcapituloId], references: [id])

  @@unique([codigo])
}

model APUEstandar {
  id                 String                @id @default(cuid())
  subrubroId         String                @unique
  subrubro           SubrubroEstandar      @relation(fields: [subrubroId], references: [id], onDelete: Cascade)
  gastosGeneralesPct Float                 @default(15)
  utilidadPct        Float                 @default(10)
  // Ver APU.porcentajePiedra — mismo campo a nivel de biblioteca estándar.
  porcentajePiedra   Float                 @default(0.30)
  materiales         MaterialAPUEstandar[]
  manoObra           ManoObraAPUEstandar[]
  equipos            EquipoAPUEstandar[]
}

model MaterialAPUEstandar {
  id          String      @id @default(cuid())
  descripcion String
  unidad      String
  rendimiento Float
  apuId       String
  apu         APUEstandar @relation(fields: [apuId], references: [id], onDelete: Cascade)
}

model ManoObraAPUEstandar {
  id          String      @id @default(cuid())
  categoria   String
  jornadaHs   Float       @default(8)
  rendimiento Float
  apuId       String
  apu         APUEstandar @relation(fields: [apuId], references: [id], onDelete: Cascade)

  // Mismo vínculo que ManoObraAPU.equipoRelacionadoId, a nivel de biblioteca
  // estándar — se propaga al clonar hacia un APU real (ver clonar-apu route).
  equipoRelacionadoId String?
  equipoRelacionado   EquipoAPUEstandar? @relation("ArmadoDeEquipoEstandar", fields: [equipoRelacionadoId], references: [id], onDelete: SetNull)
}

model EquipoAPUEstandar {
  id          String      @id @default(cuid())
  descripcion String
  unidad      String
  rendimiento Float
  apuId       String
  apu         APUEstandar @relation(fields: [apuId], references: [id], onDelete: Cascade)
  manoObraRelacionada ManoObraAPUEstandar[] @relation("ArmadoDeEquipoEstandar")
}

model PrecioMTOP {
  id             String   @id @default(cuid())
  codigo         String   @unique
  descripcion    String
  cantidadUnidad String
  unidad         String
  cantidad       Float
  precioConIva   Float
  precioUnitario Float
  numeroLista    Int      @default(599)
  fechaLista     String   @default("2025-11")
  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  // FEAT-AI-006 — actualización periódica de precios de mercado libre.
  // Todos opcionales/con default: no rompen los registros existentes
  // (Lista MTOP oficial ni los 334 de Fase 2 sin estos datos aún).
  proveedor               String?
  nombreProducto          String?
  urlReferencia           String?
  fechaUltimaVerificacion DateTime?
  umbralAlertaPorcentaje  Float     @default(17.5)
  requiereVerificacion    Boolean   @default(false)
  motivoVerificacion      String?
  precioSugeridoPendiente Float?
}

model PrecioEquipo {
  id            String   @id @default(cuid())
  codigo        String   @unique
  descripcion   String
  unidad        String
  precioHora    Float
  fuente        String   @default("referencia_mercado_UY_2025")
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}
